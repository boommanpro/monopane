{
  "name": "@monopane/app",
  "version": "1.0.0",
  "private": true,
  "description": "monopane 的 Web 应用：可编辑画布编辑器 + 只读预览入口（基于 FlowGram free-layout）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boommanpro/monopane.git",
    "directory": "packages/app"
  },
  "scripts": {
    "dev": "cross-env MODE=app NODE_ENV=development rsbuild dev --open",
    "build": "pnpm build:all",
    "build:prod": "cross-env MODE=app NODE_ENV=production rsbuild build",
    "build:viewer": "cross-env MODE=viewer NODE_ENV=production rsbuild build && node scripts/build-viewer-template.mjs",
    "build:all": "pnpm build:viewer && pnpm build:prod",
    "build:analyze": "cross-env BUNDLE_ANALYZE=true rsbuild build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src --cache",
    "lint:fix": "eslint ./src --fix",
    "clean": "rimraf dist dist-viewer public/viewer-template.html"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.80.0",
    "@douyinfe/semi-ui": "^2.80.0",
    "@flowgram.ai/export-plugin": "1.0.15",
    "@flowgram.ai/form-materials": "1.0.15",
    "@flowgram.ai/free-container-plugin": "1.0.15",
    "@flowgram.ai/free-group-plugin": "1.0.15",
    "@flowgram.ai/free-layout-editor": "1.0.15",
    "@flowgram.ai/free-lines-plugin": "1.0.15",
    "@flowgram.ai/free-node-panel-plugin": "1.0.15",
    "@flowgram.ai/free-snap-plugin": "1.0.15",
    "@flowgram.ai/free-stack-plugin": "1.0.15",
    "@flowgram.ai/minimap-plugin": "1.0.15",
    "@flowgram.ai/panel-manager-plugin": "1.0.15",
    "@monopane/canvas": "workspace:*",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.9",
    "react": "^18",
    "react-dom": "^18",
    "styled-components": "^5"
  },
  "devDependencies": {
    "@flowgram.ai/eslint-config": "1.0.15",
    "@rsbuild/core": "^1.2.16",
    "@rsbuild/plugin-less": "^1.1.1",
    "@rsbuild/plugin-react": "^1.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/styled-components": "^5",
    "cross-env": "~7.0.3",
    "eslint": "^9.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
